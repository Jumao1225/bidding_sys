# ----------------------------------------------------
# 关系型数据库配置 (PostgreSQL)
# ----------------------------------------------------
# 采用 PostgreSQL 支持企业级并发
DATABASE_URL=postgresql://bidding_user:bidding_password@localhost:5432/bidding_sys

# ----------------------------------------------------
# 缓存与消息中间件配置 (Redis)
# ----------------------------------------------------
# 采用 Redis 支持 Celery 分布式任务队列与 SSE 实时消息推送
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------
# 关系型数据库 (PostgreSQL) 连接池高级配置
# ----------------------------------------------------
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ----------------------------------------------------
# 跨域配置 (本地前端端口)
# ----------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ----------------------------------------------------
# 大模型配置 (请填入您的真实 Key)
# ----------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o
# 所有 LLM 模型共用的最大输出 Token 数
LLM_MAX_OUTPUT_TOKENS=50000

# ChatAgent 网络异常时的最大重试次数（总尝试次数 = 该值 + 1）及指数退避
CHAT_LLM_MAX_RETRIES=5
CHAT_LLM_RETRY_BACKOFF_SECONDS=2
CHAT_LLM_RETRY_BACKOFF_MAX_SECONDS=30

# ----------------------------------------------------
# Multi-Agent 标书起草长流程开关
# ----------------------------------------------------
# false: 开启真实标书 Word 自动起草与撰写; true: 临时调试跳过
SKIP_BID_FILLER=false

# 标书填报全局并发数；同一份标书仍然禁止重复提交
BID_FILL_MAX_CONCURRENCY=2
# Redis 锁最长有效期（秒），异常退出时用于自动释放兜底
BID_FILL_LOCK_TTL_SECONDS=14400
